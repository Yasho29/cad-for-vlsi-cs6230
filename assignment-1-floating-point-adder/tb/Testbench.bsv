// Testbench.bsv
//
// Generic testbench for mkFloatingPointAdder. It is parameterised in e and m
// only through Config.bsv (typedefs E, M, NumVecs), which is regenerated by
// gen_vectors.py alongside the vector files -- retarget the width by
// re-running the generator and rebuilding, with no edits here.
//
// Vectors are loaded at simulation start from op1.hex / op2.hex /
// expected.hex (one packed value per line, in the format $readmemh expects)
// via RegFile, so changing stimulus never requires touching this file.
//
// Both sides of the DUT are driven through independent LFSRs so that
// operands are sometimes issued back-to-back and sometimes stalled, and
// results are sometimes collected immediately and sometimes left pending --
// exercising C1 (ma_put_operands blocks correctly on a full pipe), C2
// (mav_get_result only fires when a result is ready) and C3 (order
// preservation) all at once.

package Testbench;

import FloatingPointAdder :: *;
import Config :: *;
import RegFile :: *;
import FIFOF :: *;

typedef TAdd#(TAdd#(E, M), 1) OpW;          // width of one packed FP#(e,m)
typedef TAdd#(OpW, 4)         ResW;         // width of one packed FPResult#(e,m)

function Bit#(1) lfsrBit(Bit#(16) x);
   return x[0] ^ x[2] ^ x[3] ^ x[5];
endfunction

function Bit#(16) lfsrNext(Bit#(16) x);
   return { lfsrBit(x), x[15:1] };
endfunction

// Carries the exact operands and expected result alongside the DUT, enqueued
// in the very same rule firing that feeds the DUT and dequeued in the very
// same firing that reads the DUT's result. This guarantees the (op1, op2,
// expected) triple printed on a mismatch is the one that actually produced
// it, regardless of how far ahead the RegFile index has since moved.
typedef struct {
   Bit#(OpW)  op1;
   Bit#(OpW)  op2;
   Bit#(ResW) expected;
} Scoreboard deriving (Bits);

(* synthesize *)
module mkTestbench (Empty);

   RegFile#(Bit#(32), Bit#(OpW))  rf_op1 <- mkRegFileLoad("op1.hex",      0, fromInteger(valueOf(NumVecs) - 1));
   RegFile#(Bit#(32), Bit#(OpW))  rf_op2 <- mkRegFileLoad("op2.hex",      0, fromInteger(valueOf(NumVecs) - 1));
   RegFile#(Bit#(32), Bit#(ResW)) rf_exp <- mkRegFileLoad("expected.hex", 0, fromInteger(valueOf(NumVecs) - 1));

   Ifc_floating_point_adder#(E, M) dut <- mkFloatingPointAdder;

   // Small side channel, enqueued/dequeued in lockstep with the DUT's own
   // FIFOs (see rl_issue / rl_check below), so its order always matches the
   // DUT's regardless of relative FIFO depths.
   FIFOF#(Scoreboard) sb <- mkSizedFIFOF(8);

   Reg#(Bit#(32)) idx_issue <- mkReg(0);
   Reg#(Bit#(32)) idx_check <- mkReg(0);
   Reg#(Bit#(32)) num_pass  <- mkReg(0);
   Reg#(Bit#(32)) num_fail  <- mkReg(0);

   Reg#(Bit#(16)) lfsr_issue <- mkReg(16'hACE1);
   Reg#(Bit#(16)) lfsr_check <- mkReg(16'hBEEF);

   Reg#(Bool) done <- mkReg(False);

   // -------------------------------------------------------------------
   // Issue side: fires most cycles (biased toward back-to-back issue,
   // since that stresses the pipeline harder) but skips whenever the
   // LFSR says so, and always defers to the DUT's own backpressure
   // through the implicit condition on ma_put_operands (and now also on
   // sb.enq, so the scoreboard can never fall out of step with the DUT).
   // -------------------------------------------------------------------
   rule rl_issue (idx_issue < fromInteger(valueOf(NumVecs)));
      lfsr_issue <= lfsrNext(lfsr_issue);

      if (lfsr_issue[0] == 1 || lfsr_issue[1] == 1) begin  // ~75% issue rate
         Bit#(OpW)  a_bits = rf_op1.sub(idx_issue);
         Bit#(OpW)  b_bits = rf_op2.sub(idx_issue);
         Bit#(ResW) e_bits = rf_exp.sub(idx_issue);

         dut.ma_put_operands(unpack(a_bits), unpack(b_bits));
         sb.enq(Scoreboard { op1: a_bits, op2: b_bits, expected: e_bits });

         idx_issue <= idx_issue + 1;
      end
   endrule

   // -------------------------------------------------------------------
   // Check side: independently stalled, so results sometimes sit in
   // ff_output for several cycles before being collected. Pops the
   // scoreboard in the same firing as the DUT result, so the two can
   // never desynchronize.
   // -------------------------------------------------------------------
   rule rl_check (idx_check < fromInteger(valueOf(NumVecs)));
      lfsr_check <= lfsrNext(lfsr_check);

      if (lfsr_check[0] == 1 || lfsr_check[2] == 1) begin  // ~75% collect rate
         let res <- dut.mav_get_result();
         let sc   = sb.first;
         sb.deq;

         Bit#(ResW) got = pack(res);
         Bit#(ResW) exp = sc.expected;

         if (got == exp) begin
            num_pass <= num_pass + 1;
         end
         else begin
            num_fail <= num_fail + 1;
            $display("MISMATCH idx=%0d op1=%h op2=%h  got=%h exp=%h",
                      idx_check, sc.op1, sc.op2, got, exp);
         end
         idx_check <= idx_check + 1;
      end
   endrule


   rule rl_finish (idx_check == fromInteger(valueOf(NumVecs)) && !done);
      done <= True;
      $display("==============================================");
      $display("E=%0d M=%0d  vectors=%0d  PASS=%0d  FAIL=%0d",
                valueOf(E), valueOf(M), valueOf(NumVecs), num_pass, num_fail);
      $display("==============================================");
      if (num_fail == 0)
         $display("ALL VECTORS PASSED");
      else
         $display("FAILURES DETECTED -- see MISMATCH lines above");
      $finish(0);
   endrule

endmodule : mkTestbench

endpackage : Testbench
